rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------
    // Helper Functions
    // --------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin check relies solely on the Firebase custom claim `admin: true`.
    // Set this server-side via Firebase Admin SDK or Cloud Functions.
    // Alternatively falls back to checking the Firestore user document role.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','super_admin','moderator','analyst']
      );
    }

    function isFullAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','super_admin']
      );
    }

    function isCourier() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'courier';
    }

    // --------------------------------------------------------------------
    // Collections
    // --------------------------------------------------------------------

    match /users/{userId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();

      match /wishlist/{productId} { allow read, write: if isOwner(userId); }
      match /cart/{productId} { allow read, write: if isOwner(userId); }
      match /addresses/{addressId} { allow read, write: if isOwner(userId); }
      match /paymentMethods/{methodId} { allow read, write: if isOwner(userId); }
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      // Seller or admin can update freely. Additionally, any signed-in user
      // can perform two narrow updates:
      //   1. Decrement `quantity` (and optionally flip `status` to `reserved`)
      //      — buyer-at-checkout flow.
      //   2. Increment `views` by 1 — product-detail view counter.
      //   3. Adjust `wishlistCount` by ±1 — wishlist add/remove flow.
      // Anything touching other fields requires seller or admin.
      allow update: if isSignedIn() && (
        resource.data.sellerId == request.auth.uid
        || isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'status'])
          && request.resource.data.quantity is int
          && request.resource.data.quantity >= 0
          && request.resource.data.quantity < resource.data.get('quantity', 1)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
              || request.resource.data.status == 'reserved')
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && request.resource.data.views is int
          && request.resource.data.views == resource.data.get('views', 0) + 1
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wishlistCount'])
          && request.resource.data.wishlistCount is int
          && (
            request.resource.data.wishlistCount == resource.data.get('wishlistCount', 0) + 1
            || request.resource.data.wishlistCount == resource.data.get('wishlistCount', 0) - 1
          )
          && request.resource.data.wishlistCount >= 0
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);

      match /offers/{offerId} {
        allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || get(/databases/$(database)/documents/products/$(productId)).data.sellerId == request.auth.uid || isAdmin());
        allow create: if isSignedIn();
        allow update: if isSignedIn();
      }
    }

    // Catalog metadata — public read is fine
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /brands/{id} { allow read: if true; allow write: if isAdmin(); }
    match /conditions/{id} { allow read: if true; allow write: if isAdmin(); }
    match /materials/{id} { allow read: if true; allow write: if isAdmin(); }
    match /colors/{id} { allow read: if true; allow write: if isAdmin(); }
    match /patterns/{id} { allow read: if true; allow write: if isAdmin(); }
    match /size_charts/{id} { allow read: if true; allow write: if isAdmin(); }

    match /settings/global { allow read: if true; allow write: if isFullAdmin(); }
    match /settings/banners { allow read: if true; allow write: if isAdmin(); }
    match /settings/macro_filters { allow read: if true; allow write: if isAdmin(); }
    match /settings/homepage_blocks { allow read: if true; allow write: if isAdmin(); }
    match /settings/badges { allow read: if true; allow write: if isAdmin(); }
    match /config/exchangeRates { allow read: if true; }
    match /admin_logs/{logId} { allow read, write: if isAdmin(); }

    // Coupons: signed-in users can query by code during checkout (they need
    // the exact code). Only admins can create/update/delete coupons.
    // This prevents unauthenticated enumeration while allowing checkout validation.
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || request.auth.uid in resource.data.sellerIds || isAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && (resource.data.buyerId == request.auth.uid || request.auth.uid in resource.data.sellerIds));
      // Admin-only delete — used by the operator reset tool at
      // /admin/danger/reset-orders. No buyer/seller delete path; cancellations
      // go through status updates, not deletions.
      allow delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Any signed-in user can create a notification (e.g. seller notifying
      // buyer of a status change, buyer notifying seller of a refund request).
      // The targeted userId must be present so it can be queried by recipient.
      allow create: if isSignedIn() && request.resource.data.userId is string;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Deliveries: courier/admin can read everything; the buyer and sellers
    // of the linked order can also read their own delivery so the order page
    // can render tracking. Writes remain restricted.
    match /deliveries/{id} {
      allow read: if isSignedIn() && (
        isCourier() || isAdmin() ||
        request.auth.uid == get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.buyerId ||
        request.auth.uid in get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.sellerIds
      );
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && resource.data.courierId == request.auth.uid);
    }

    match /courier_profiles/{id} {
      allow read: if isOwner(id) || isAdmin();
      allow write: if isAdmin() || isOwner(id);
    }

    match /reports/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }

    match /support_chats/{chatId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      // Support messages: only the chat owner and admins can read/write
      match /messages/{msgId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/support_chats/$(chatId)).data.userId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isSignedIn() && (
          get(/databases/$(database)/documents/support_chats/$(chatId)).data.userId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
          isAdmin()
        );
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
          isAdmin()
        );
      }
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }

    match /refunds/{refundId} {
      allow read: if isSignedIn() && (resource.data.requestedBy == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /disputes/{disputeId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /returns/{returnId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      // Admins can do anything. The buyer drives the in-transit phase (packs
      // the item, hands it to the courier): `approved → ready_for_pickup`
      // and `ready_for_pickup → shipping`. The seller drives the receiving
      // phase: `shipping → received`. Any other transition (refund / reject /
      // etc.) stays admin-only.
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.buyerId == request.auth.uid
        && (
          (resource.data.status == 'approved' && request.resource.data.status == 'ready_for_pickup')
          || (resource.data.status == 'ready_for_pickup' && request.resource.data.status == 'shipping')
        )
      ) || (
        isSignedIn()
        && resource.data.sellerId == request.auth.uid
        && resource.data.status == 'shipping'
        && request.resource.data.status == 'received'
      );
      allow delete: if isAdmin();
    }

    // Finance ledger. Append-only: admins create rows from order-lifecycle
    // helpers; nobody updates or deletes them. Readable by the buyer/seller
    // tied to the transaction so each side can show their own history.
    match /transactions/{txnId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if false;
      // Admin-only delete — used by the operator reset tool to clear out
      // ledger rows that referenced wiped orders.
      allow delete: if isAdmin();
    }

    // No wildcard catch-all rule. Every collection must have explicit rules.
  }
}