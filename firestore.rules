rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------
    // Helper Functions
    // --------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin check relies solely on the Firebase custom claim `admin: true`.
    // Set this server-side via Firebase Admin SDK or Cloud Functions.
    // Alternatively falls back to checking the Firestore user document role.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','super_admin','moderator','analyst']
      );
    }

    function isFullAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','super_admin']
      );
    }

    function isCourier() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'courier';
    }

    // A ban is `users/{uid}.status == 'banned'`, set from /admin/users. For a
    // long time that was the whole of it — a label the admin table could
    // filter on — and a banned buyer went on making offers, buying and
    // messaging exactly as before, because nothing below ever looked at it.
    //
    // This is the layer that actually stops them. The Cloud Function
    // `syncBanToAuth` also disables the Auth user and revokes their refresh
    // tokens, but an ID token already issued stays valid for up to an hour
    // and cannot be recalled, so for that hour these rules are the only
    // thing in the way. Every write a member can make is gated on
    // `isActiveUser()`; admin branches are not, so an operator can still act
    // on a banned account's data.
    //
    // Reads are deliberately not gated: the helper costs a document read,
    // and every public page would pay it.
    function isBanned() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'banned';
    }

    function isActiveUser() {
      return isSignedIn() && !isBanned();
    }

    // --------------------------------------------------------------------
    // Collections
    // --------------------------------------------------------------------

    match /users/{userId} {
      allow get: if true;
      allow list: if isAdmin();

      // `role` and `status` are the two fields the rest of this file trusts:
      // isAdmin() falls back to the stored role, and isBanned() reads the
      // status. The owner used to be able to write both — which meant any
      // account could promote itself to super_admin from the browser console,
      // and a banned one could simply unban itself. They are now admin-only.
      // The first-login bootstrap in FirebaseProvider writes `buyer` / `active`
      // and nothing else may.
      allow create: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.get('role', 'buyer') == 'buyer'
        && request.resource.data.get('status', 'active') == 'active'
      );
      // A banned member may not edit their own profile either — the display
      // name is public. `resource` is this very document, so no extra read.
      allow update: if isAdmin() || (
        isOwner(userId)
        && resource.data.get('status', 'active') != 'banned'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])
      );

      match /wishlist/{productId} { allow read, write: if isOwner(userId); }
      match /cart/{productId} { allow read, write: if isOwner(userId); }
      match /addresses/{addressId} { allow read, write: if isOwner(userId); }
      match /paymentMethods/{methodId} { allow read, write: if isOwner(userId); }
    }

    // Email activation codes (6-digit OTP), one document per account.
    //
    // Read and written by /api/auth/send-otp and /api/auth/verify-otp, which
    // reach Firestore with the *caller's own* ID token — this app carries no
    // service-account key (see CLAUDE.md §6) — so the server has exactly the
    // owner's privileges and the owner must therefore hold both here.
    //
    // That costs nothing, because the stored `codeHash` is an HMAC keyed with
    // OTP_SECRET, which never leaves the server (src/lib/otp.ts). Reading it
    // reveals nothing about the six digits: unlike a plain hash of a code
    // drawn from a million possibilities, an HMAC under an unknown key is not
    // brute-forceable offline. Writing one is equally useless — a digest
    // forged without the key can never match a submitted code.
    //
    // What the owner *can* do is reset their own `attempts` counter, which is
    // why the real brute-force limit is the per-IP one in src/lib/rate-limit.ts
    // rather than this document. No delete rule: a spent challenge is cleared
    // in place, so nothing here is ever removed.
    match /email_verifications/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /products/{productId} {
      allow read: if true;
      // A seller lists their own items. An admin may also list *on behalf of*
      // a seller — operator-led onboarding, where stock is photographed and
      // catalogued centrally before the seller ever opens the app.
      //
      // This is a real widening: an admin can create a listing attributed to
      // any account, and the seller has no say in it. It is granted because
      // the alternative was signing in as the seller, which means handling
      // their password. `sellerId` is still required and must be a real string,
      // so a listing can never end up ownerless — every downstream screen
      // (earnings, payouts, the seller's own listings page) keys off it.
      allow create: if isActiveUser()
        && request.resource.data.sellerId is string
        && request.resource.data.sellerId.size() > 0
        && (request.resource.data.sellerId == request.auth.uid || isAdmin());
      // Seller or admin can update freely. Additionally, any signed-in user
      // can perform two narrow updates:
      //   1. Decrement `quantity` (and optionally flip `status` to `reserved`)
      //      — buyer-at-checkout flow.
      //   2. Increment `views` by 1 — product-detail view counter.
      //   3. Adjust `wishlistCount` by ±1 — wishlist add/remove flow.
      // Anything touching other fields requires seller or admin.
      allow update: if isAdmin() || (isActiveUser() && (
        resource.data.sellerId == request.auth.uid
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'status'])
          && request.resource.data.quantity is int
          && request.resource.data.quantity >= 0
          && request.resource.data.quantity < resource.data.get('quantity', 1)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
              || request.resource.data.status == 'reserved')
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && request.resource.data.views is int
          && request.resource.data.views == resource.data.get('views', 0) + 1
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wishlistCount'])
          && request.resource.data.wishlistCount is int
          && (
            request.resource.data.wishlistCount == resource.data.get('wishlistCount', 0) + 1
            || request.resource.data.wishlistCount == resource.data.get('wishlistCount', 0) - 1
          )
          && request.resource.data.wishlistCount >= 0
        )
      ));
      allow delete: if isAdmin() || (isActiveUser() && resource.data.sellerId == request.auth.uid);

      // Offers. The transition table here mirrors TRANSITIONS in
      // src/lib/offers.ts — if one changes, change both, or the UI will offer
      // a button the database rejects.
      //
      // Previously `create` and `update` were both `isSignedIn()`, which let
      // any signed-in user forge an offer in someone else's name and — worse —
      // accept their own pending offer on someone else's listing.
      match /offers/{offerId} {
        function listingSeller() {
          return get(/databases/$(database)/documents/products/$(productId)).data.sellerId;
        }
        function isBuyer() { return isSignedIn() && resource.data.buyerId == request.auth.uid; }
        function isSeller() { return isSignedIn() && listingSeller() == request.auth.uid; }

        allow read: if isBuyer() || isSeller() || isAdmin();

        allow create: if isActiveUser()
          && request.resource.data.buyerId == request.auth.uid
          && request.resource.data.sellerId == listingSeller()
          // A seller bidding on their own listing is either a mistake or an
          // attempt to fake interest.
          && request.auth.uid != listingSeller()
          && request.resource.data.status == 'pending'
          && request.resource.data.offerAmount is number
          && request.resource.data.offerAmount > 0
          && request.resource.data.offerAmount < get(/databases/$(database)/documents/products/$(productId)).data.price;

        allow update: if isAdmin() || (
          isActiveUser() && (isBuyer() || isSeller())
          // Identities and the parent listing are immutable for the life of
          // the negotiation.
          && request.resource.data.buyerId == resource.data.buyerId
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.offerAmount == resource.data.offerAmount
          // Only a live offer can move at all.
          && resource.data.status in ['pending', 'countered']
          && (
            // Seller answers the buyer's offer.
            (isSeller() && resource.data.status == 'pending'
              && request.resource.data.status in ['accepted', 'declined', 'countered'])
            // Seller walks away from their own counter.
            || (isSeller() && resource.data.status == 'countered'
              && request.resource.data.status == 'declined')
            // Buyer may only retract while the ball is in the seller's court.
            || (isBuyer() && resource.data.status == 'pending'
              && request.resource.data.status == 'withdrawn')
            // Buyer answers a counter — including countering back, which
            // returns the turn to the seller.
            || (isBuyer() && resource.data.status == 'countered'
              && request.resource.data.status in ['accepted', 'declined', 'withdrawn', 'pending'])
          )
        );

        allow delete: if isAdmin();
      }
    }

    // Collection-group reads of offers, for "my offers" on both sides.
    //
    // A rule nested under /products/{productId} does **not** apply to a
    // collectionGroup('offers') query — Firestore matches those against a
    // `{path=**}` rule only — so without this the buyer's and seller's offer
    // lists are denied no matter what the nested rule says.
    //
    // The query must therefore be constrained by buyerId or sellerId, which is
    // exactly why both are denormalised onto the offer document: resolving the
    // seller through the parent product is not possible here.
    match /{path=**}/offers/{offerId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid
        || resource.data.sellerId == request.auth.uid
        || isAdmin()
      );
    }

    // Catalog metadata — public read is fine
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /brands/{id} { allow read: if true; allow write: if isAdmin(); }
    match /conditions/{id} { allow read: if true; allow write: if isAdmin(); }
    match /materials/{id} { allow read: if true; allow write: if isAdmin(); }
    match /colors/{id} { allow read: if true; allow write: if isAdmin(); }
    match /patterns/{id} { allow read: if true; allow write: if isAdmin(); }
    match /size_charts/{id} { allow read: if true; allow write: if isAdmin(); }

    match /settings/global { allow read: if true; allow write: if isFullAdmin(); }
    match /settings/banners { allow read: if true; allow write: if isAdmin(); }
    match /settings/macro_filters { allow read: if true; allow write: if isAdmin(); }
    match /settings/homepage_blocks { allow read: if true; allow write: if isAdmin(); }
    match /settings/badges { allow read: if true; allow write: if isAdmin(); }
    match /config/exchangeRates { allow read: if true; }
    match /admin_logs/{logId} { allow read, write: if isAdmin(); }

    // Coupons: signed-in users can query by code during checkout (they need
    // the exact code). Only admins can create/update/delete coupons.
    // This prevents unauthenticated enumeration while allowing checkout validation.
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      // Checkout spends a coupon with the *buyer's* token — the API routes
      // have no service account (CLAUDE.md §6) — so a member may bump
      // `usedCount` by exactly one and touch nothing else. Every other
      // field, and any other step, stays admin-only. Same shape as the
      // `views` counter on products.
      allow update: if isAdmin() || (
        isActiveUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
        && request.resource.data.usedCount is int
        && request.resource.data.usedCount == resource.data.get('usedCount', 0) + 1
      );
      allow create, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || request.auth.uid in resource.data.sellerIds || isAdmin());
      allow create: if isActiveUser();
      allow update: if isAdmin() || (isActiveUser() && (resource.data.buyerId == request.auth.uid || request.auth.uid in resource.data.sellerIds));
      // Admin-only delete — used by the operator reset tool at
      // /admin/danger/reset-orders. No buyer/seller delete path; cancellations
      // go through status updates, not deletions.
      allow delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Any signed-in user can create a notification (e.g. seller notifying
      // buyer of a status change, buyer notifying seller of a refund request).
      // The targeted userId must be present so it can be queried by recipient.
      allow create: if isActiveUser() && request.resource.data.userId is string;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Deliveries: courier/admin can read everything; the buyer and sellers
    // of the linked order can also read their own delivery so the order page
    // can render tracking. Writes remain restricted.
    match /deliveries/{id} {
      allow read: if isSignedIn() && (
        isCourier() || isAdmin() ||
        request.auth.uid == get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.buyerId ||
        request.auth.uid in get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.sellerIds
      );
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && resource.data.courierId == request.auth.uid);
    }

    match /courier_profiles/{id} {
      allow read: if isOwner(id) || isAdmin();
      allow write: if isAdmin() || (isOwner(id) && isActiveUser());
    }

    match /reports/{id} {
      allow read: if isAdmin();
      allow create: if isActiveUser();
      allow update: if isAdmin();
    }

    match /support_chats/{chatId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isActiveUser();
      allow update: if isAdmin() || (isActiveUser() && resource.data.userId == request.auth.uid);

      // Support messages: only the chat owner and admins can read/write
      match /messages/{msgId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/support_chats/$(chatId)).data.userId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isAdmin() || (
          isActiveUser()
          && get(/databases/$(database)/documents/support_chats/$(chatId)).data.userId == request.auth.uid
        );
      }
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isActiveUser() && request.auth.uid in request.resource.data.participants;
      allow update: if isAdmin() || (isActiveUser() && request.auth.uid in resource.data.participants);

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
          isAdmin()
        );
        allow create: if isActiveUser()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isAdmin() || (
          isActiveUser()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );
      }
    }

    match /reviews/{id} {
      function reviewedOrder() {
        return get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data;
      }

      // Public: reviews feed the seller's rating and the aggregateRating in
      // each listing's JSON-LD, so they are read by crawlers as well as buyers.
      allow read: if true;

      // That SEO path is exactly why `isSignedIn()` alone was not enough here.
      // The client Firebase config ships in the browser bundle, so anyone could
      // POST a review naming any reviewerId and any seller — and it would land
      // in Google's rich results as stars on a product page. A review is now
      // only accepted from the buyer of a real, delivered order, about a seller
      // who was actually on it.
      allow create: if isActiveUser()
        && request.resource.data.reviewerId == request.auth.uid
        // No reviewing yourself, however the order is shaped.
        && request.resource.data.revieweeId != request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 2000
        && request.resource.data.orderId is string
        // The order must be the caller's, far enough along that they have the
        // item in hand, and the reviewee must be a seller on it.
        && reviewedOrder().buyerId == request.auth.uid
        && request.resource.data.revieweeId in reviewedOrder().sellerIds
        && reviewedOrder().status in ['delivered', 'completed'];

      // Edits are admin-only: a review the seller could talk you into changing
      // is not a review. Removal is moderation, so it is admin-only too.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /refunds/{refundId} {
      allow read: if isSignedIn() && (resource.data.requestedBy == request.auth.uid || isAdmin());
      allow create: if isActiveUser();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /disputes/{disputeId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isActiveUser();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /returns/{returnId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isActiveUser();
      // Admins can do anything. The buyer drives the in-transit phase (packs
      // the item, hands it to the courier): `approved → ready_for_pickup`
      // and `ready_for_pickup → shipping`. The seller drives the receiving
      // phase: `shipping → received`. Any other transition (refund / reject /
      // etc.) stays admin-only.
      allow update: if isAdmin() || (
        isActiveUser()
        && resource.data.buyerId == request.auth.uid
        && (
          (resource.data.status == 'approved' && request.resource.data.status == 'ready_for_pickup')
          || (resource.data.status == 'ready_for_pickup' && request.resource.data.status == 'shipping')
        )
      ) || (
        isActiveUser()
        && resource.data.sellerId == request.auth.uid
        && resource.data.status == 'shipping'
        && request.resource.data.status == 'received'
      );
      allow delete: if isAdmin();
    }

    // Finance ledger. Append-only: admins create rows from order-lifecycle
    // helpers; nobody updates or deletes them. Readable by the buyer/seller
    // tied to the transaction so each side can show their own history.
    match /transactions/{txnId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if false;
      // Admin-only delete — used by the operator reset tool to clear out
      // ledger rows that referenced wiped orders.
      allow delete: if isAdmin();
    }

    // No wildcard catch-all rule. Every collection must have explicit rules.
  }
}