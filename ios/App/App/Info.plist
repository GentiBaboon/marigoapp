<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>MarigoApp</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Not $(PRODUCT_NAME): the target is called "App", and iOS shows this
	     name in system prompts such as "App wants to use accounts.google.com
	     to sign in". -->
	<key>CFBundleName</key>
	<string>MarigoApp</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<!-- Google sign-in returns to the app through this scheme. It is the
	     REVERSED_CLIENT_ID from GoogleService-Info.plist and must match it
	     exactly; regenerate both together if the iOS app is ever re-registered
	     in Firebase. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>google-sign-in</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.329665870351-purfra5gh4mmh7ka9karj7oap4sm4bs6</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- Permission prompts. iOS kills the app on the spot if it touches the
	     camera or photo library without the matching string here, and App
	     Review treats a missing or vague one as a rejection. Each says what the
	     app does with the data, which is what the guideline asks for. -->
	<key>NSCameraUsageDescription</key>
	<string>MarigoApp uses the camera so you can photograph an item you are listing for sale.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>MarigoApp needs access to your photos so you can choose pictures of an item you are listing for sale.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>MarigoApp saves photos to your library when you download an image of a listing.</string>

	<!-- The app uses only standard HTTPS/TLS, which is exempt. Declaring it
	     here answers the export-compliance question once instead of on every
	     single upload to App Store Connect. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
