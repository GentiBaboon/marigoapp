<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Push notification appearance.

             Android draws a notification's small icon from its ALPHA CHANNEL
             alone and fills the result with the accent colour, so pointing
             this at @mipmap/ic_launcher — the default when it is absent —
             produces a solid white square in the status bar. ic_stat_marigo is
             the brand "m" as a transparent silhouette, which is what the
             platform actually wants.

             These are the defaults for a message whose payload does not name
             its own icon or colour; sendPushForNotification sets the colour
             explicitly as well, so the two agree either way. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_marigo" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/brandPurple" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Photographing an item while listing it. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Choosing existing listing photos. Android 13 split the old blanket
         storage permission into per-media types, so both are declared and the
         legacy one is capped at the last release that used it. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Offers, order updates and messages. Runtime-prompted from Android 13;
         without this the push registration silently never delivers. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The camera is optional: a buyer who never sells still needs the app to
         install on a device without one. Omitting this makes Play treat the
         CAMERA permission as a hardware requirement and hides the listing from
         those devices. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
</manifest>
