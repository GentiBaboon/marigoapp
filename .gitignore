# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Playwright output — only populated when a run fails, so it stays invisible
# until the day someone `git add -A`s a red run.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*

# firebase
firebase-debug.log

# Local product photography used for seeding listings — ~465MB of source
# images that belong in storage, not in git history.
/Marigo App Products/
firestore-debug.log
functions/node_modules
functions/lib
.firebase/

# testing artifacts
playwright-report/
test-results/

# PWA generated files
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/worker-*.js
public/worker-*.js.map
# Local-only screenshots for product imports
ImportPhotos/

# Claude harness worktrees
.claude/worktrees/

# Capacitor native build
# The static export consumed by the iOS/Android shells. Regenerated by
# `npm run build:native`; kept out of `.next` so a production build can never
# clobber the dev server's chunks.
.next-native/
# Scratch dist dir for NEXT_DIST_DIR builds
.next-webcheck/

# Native platform build output. The ios/ and android/ project folders
# themselves are committed — they hold signing config, icons and plugin
# registration — but their build artefacts are not.
ios/App/Pods/
ios/App/App/public/
ios/App/build/
ios/DerivedData/
android/app/src/main/assets/public/
android/.gradle/
android/build/
android/app/build/
android/local.properties

# Android release signing. The keystore and its passwords must never be
# committed — losing the keystore means losing the ability to update the
# Play listing, and leaking it lets anyone ship as you.
android/keystore.properties
*.jks
*.keystore

# Built store artefacts. Regenerated by `cd android && ./gradlew bundleRelease`;
# they are large, signed, and rebuilt per release, so they don't belong in git.
*.aab
*.apk
