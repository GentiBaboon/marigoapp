/Marigo App Products/
firestore-debug.log
functions/node_modules
functions/lib
.firebase/

# testing artifacts
playwright-report/
test-results/

# PWA generated files
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/worker-*.js
public/worker-*.js.map
# Local-only screenshots for product imports
ImportPhotos/

# Claude harness worktrees
.claude/worktrees/

# Capacitor native build
# The static export consumed by the iOS/Android shells. Regenerated by
# `npm run build:native`; kept out of `.next` so a production build can never
# clobber the dev server's chunks.
.next-native/
# Scratch dist dir for NEXT_DIST_DIR builds
.next-webcheck/
.next-check/

# Native platform build output. The ios/ and android/ project folders
# themselves are committed — they hold signing config, icons and plugin
# registration — but their build artefacts are not.
ios/App/Pods/
ios/App/App/public/
ios/App/build/
ios/DerivedData/
android/app/src/main/assets/public/
android/.gradle/
android/build/
android/app/build/
android/local.properties

# Android release signing. The keystore and its passwords must never be
# committed — losing the keystore means losing the ability to update the
# Play listing, and leaking it lets anyone ship as you.
android/keystore.properties
*.jks
*.keystore

# Firebase native config. Google does not class these as secrets — the ids in
# them are meant to ship inside the app — but each carries its own Google API
# key, and a freshly created one is UNRESTRICTED: on a public repository that
# is a billable-API abuse surface, not merely an identifier. They are pulled
# per machine from the Firebase console instead (docs/store-release.md §2.1),
# the same arrangement as the keystore above.
#
# Restrict both keys in the Google Cloud console — the iOS key to the bundle
# id, the Android key to the package name plus signing SHA-1 — and this
# becomes a much smaller question.
#
# Without them the app still BUILDS; push and Apple sign-in simply do not work
# at runtime, which is the failure mode to watch for on a fresh clone.
ios/App/App/GoogleService-Info.plist
android/app/google-services.json

# Apple push signing key. Apple keeps no copy — it downloads exactly once.
*.p8

# Built store artefacts. Regenerated by `cd android && ./gradlew bundleRelease`;
# they are large, signed, and rebuilt per release, so they don't belong in git.
*.aab
*.apk

# Release artifacts for store upload (never commit binaries)
dist/

# Rendered email previews (scripts/preview-emails.mjs) — generated, not source
email-previews/

# Original supporter-logo artwork, dropped in to be processed by hand.
# The versions the site actually serves live in public/partners/ — these
# sources were swept in by a stray `git add -A` and are not repo assets.
Logo to place in website footer/
