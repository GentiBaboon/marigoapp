# ──────────────────────────────────────────────────────────
# MarigoApp Environment Variables
# Copy this file to .env.local and fill in the values.
# ──────────────────────────────────────────────────────────

# ── Firebase (Client-side — NEXT_PUBLIC_ prefix required) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=europe-west1

# ── Stripe ──
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# ── Supabase (Image Storage) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google AI (Genkit) ──
GOOGLE_GENAI_API_KEY=

# Optional model overrides. Google retires Gemini models with no warning and
# then returns 404 for them — `gemini-2.0-flash` died this way and took every
# AI feature down. Setting these lets you move to a live model without a code
# change; leave blank to use the defaults in src/ai/models.ts.
GENAI_TEXT_MODEL=
GENAI_IMAGE_MODEL=

# ── Email (SendGrid) ──
# Transactional email. The FROM address must be a verified Single Sender or on
# an authenticated domain, or every send returns 403. Verify the whole setup
# with `node scripts/check-email-config.mjs` before trusting it.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@marigoapp.com
SENDGRID_FROM_NAME=Marigo Fashion Marketplace
# Where a reply lands — the From is a no-reply mailbox, so without this a
# customer hitting Reply writes into a void.
SENDGRID_REPLY_TO=hello@marigoapp.com
# Operational alerts (new sign-up, new order, cancelled order). Point this at a
# staging inbox on non-production deployments so they don't page the live one.
ADMIN_EMAIL=hello@marigoapp.com

# ── Unsubscribe ──
# Signs the per-recipient unsubscribe links. Any high-entropy string; rotating
# it invalidates links already sitting in people's inboxes. Falls back to
# SENDGRID_API_KEY when unset, which works but ties link validity to the key.
UNSUBSCRIBE_SECRET=
# SendGrid suppression group id (Marketing → Unsubscribe Groups). With one set,
# an opt-out silences only non-essential mail and receipts still arrive. Leave
# blank and an opt-out falls back to SendGrid's global list, which stops
# everything.
SENDGRID_UNSUBSCRIBE_GROUP_ID=

# Legacy — superseded by SendGrid.
MAILTRAP_TOKEN=

# ── Password Reset ──
RESET_SERVICE_SECRET=

# Signs the 6-digit email activation codes and the verification proof stored on
# each user document. Generate with: openssl rand -hex 32
# Falls back to RESET_SERVICE_SECRET when unset, so the flow works before you
# set it — but set it, so the two can be rotated independently.
OTP_SECRET=

# ── Admin gate (masks the /admin door) ──
# Visiting ADMIN_UNLOCK_PATH once per device mints an httpOnly cookie; without
# it /admin returns 404 rather than 403, so it does not admit a panel exists.
# This is obscurity, not authentication — useAdminAuth, the role table and the
# Firestore rules are still what actually stop an attacker. It exists because
# essentially all traffic hitting /admin is a scanner walking a wordlist.
# Both are SERVER-ONLY: never prefix them with NEXT_PUBLIC_, or the secret
# lands in the JS bundle and the masking is worth nothing.
# Leave both blank to switch the gate off; /admin then behaves as it always did.
#   ADMIN_UNLOCK_PATH must start with "/". Pick something unguessable.
#   ADMIN_GATE_SECRET: openssl rand -hex 32   (16+ chars required)
ADMIN_UNLOCK_PATH=
ADMIN_GATE_SECRET=

# ── Live visitor presence (admin → Analytics) ──
# Upstash Redis, over its REST API. Presence is written constantly, read
# rarely, and worthless after 90 seconds, so it lives on keys with a TTL rather
# than in Firestore — which would also have meant opening an unauthenticated
# Firestore write path, since most shoppers browse signed out and this app has
# no service-account key. See src/lib/presence.ts.
# Create a free database at https://console.upstash.com → Redis → REST API.
# Leave blank to switch the live view off; the rest of Analytics still works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Site URL ──
# Used by next-sitemap (runs on postbuild) for sitemap.xml and robots.txt.
# Falls back to https://www.marigoapp.com when unset. On Vercel set this to the
# production domain so the generated sitemap doesn't point at the wrong host.
SITE_URL=
